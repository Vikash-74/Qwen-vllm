# Router targets: use the current LAN IP addresses of the two inference machines.
LOCAL_VLLM_URL=localhost:8000
REMOTE_VLLM_URL=http://192.168.1.102:8000

# Router policy: round_robin or consistent_hash
ROUTER_POLICY=round_robin
ROUTER_PORT=8001
ROUTER_METRICS_PORT=9000
ROUTER_HEALTH_INTERVAL=10

# Monitoring machine LAN IP; Jaeger OTLP HTTP receiver listens on 4318.
MONITORING_HOST_IP=192.168.1.100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
GRAFANA_ADMIN_PASSWORD=change-this-password

CLICKHOUSE_USER=forecaster
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000


# Optional DCGM exporter
DCGM_EXPORTER_PORT=9400
